<script src="https://unpkg.com/cytoscape@3.30.2/dist/cytoscape.min.js"></script>

<%
  baseline_flows = @analysis_result["baseline_flows"] || []
  test_flows = @analysis_result["test_flows"] || []
  alerts = @analysis_result["alerts"] || []
  top_talkers = @analysis_result["top_talkers"] || []
  protocol_distribution = @analysis_result["protocol_distribution"] || %{}
  baseline_profile = @analysis_result["baseline_profile"] || %{}

  known_src_ips = baseline_profile["known_src_ips"] || []
  known_dst_ips = baseline_profile["known_dst_ips"] || []
  known_dst_ports = baseline_profile["known_dst_ports"] || []
  known_protocols = baseline_profile["known_protocols"] || []
  known_services = baseline_profile["known_services"] || []

  local_ip = List.first(known_src_ips) || "Local Device"

  low_alerts = Enum.count(alerts, &(&1["risk_level"] == "Low"))
  medium_alerts = Enum.count(alerts, &(&1["risk_level"] == "Medium"))
  high_alerts = Enum.count(alerts, &(&1["risk_level"] == "High"))
%>

<style>
  :root {
    --background: #070b12;
    --surface: #0d1420;
    --surface-light: #111b2a;
    --border: #1e2b3d;
    --border-bright: #30445e;
    --text: #e6edf7;
    --muted: #8291a8;
    --blue: #38bdf8;
    --green: #34d399;
    --yellow: #facc15;
    --orange: #fb923c;
    --red: #f87171;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--background);
  }

  .nbm-page {
    min-height: 100vh;
    padding: 28px;
    color: var(--text);
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    background:
      radial-gradient(circle at 10% 0%, rgba(56, 189, 248, 0.09), transparent 30%),
      radial-gradient(circle at 90% 20%, rgba(52, 211, 153, 0.06), transparent 25%),
      #070b12;
  }

  .nbm-container {
    width: min(1500px, 100%);
    margin: 0 auto;
  }

  .nbm-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 24px;
  }

  .nbm-title {
    margin: 0;
    font-size: clamp(30px, 4vw, 46px);
    letter-spacing: -1.5px;
  }

  .nbm-subtitle {
    max-width: 720px;
    margin: 8px 0 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    flex-shrink: 0;
    padding: 10px 14px;
    border: 1px solid rgba(52, 211, 153, 0.35);
    border-radius: 999px;
    background: rgba(52, 211, 153, 0.08);
    color: #a7f3d0;
    font-size: 13px;
    font-weight: 700;
  }

  .status-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 12px rgba(52, 211, 153, 0.85);
  }

  .card {
    border: 1px solid var(--border);
    border-radius: 16px;
    background: rgba(13, 20, 32, 0.94);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.2);
  }

  .summary-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    align-items: center;
    padding: 15px 18px;
    margin-bottom: 20px;
    color: var(--muted);
    font-size: 13px;
  }

  .summary-strip strong {
    color: var(--text);
  }

  .summary-strip code {
    padding: 4px 7px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: #080d15;
    color: #bae6fd;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(150px, 1fr));
    gap: 14px;
    margin-bottom: 20px;
  }

  .stat-card {
    min-height: 116px;
    padding: 18px;
    overflow: hidden;
    position: relative;
  }

  .stat-card::after {
    content: "";
    position: absolute;
    right: -30px;
    bottom: -45px;
    width: 110px;
    height: 110px;
    border-radius: 50%;
    background: var(--stat-glow, rgba(56, 189, 248, 0.12));
    filter: blur(3px);
  }

  .stat-label {
    position: relative;
    z-index: 1;
    color: var(--muted);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .stat-value {
    position: relative;
    z-index: 1;
    margin-top: 10px;
    font-size: 31px;
    font-weight: 800;
    line-height: 1;
  }

  .stat-note {
    position: relative;
    z-index: 1;
    margin-top: 9px;
    color: var(--muted);
    font-size: 12px;
  }

  .section {
    margin-top: 20px;
  }

  .section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 12px;
  }

  .section-title {
    margin: 0;
    font-size: 19px;
  }

  .section-description {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 13px;
  }

  .graph-card {
    overflow: hidden;
  }

  .graph-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
    background: #0a111c;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 18px;
    color: var(--muted);
    font-size: 12px;
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .legend-line {
    width: 22px;
    height: 3px;
    border-radius: 999px;
  }

  .graph-buttons {
    display: flex;
    gap: 8px;
  }

  .graph-button {
    padding: 8px 11px;
    border: 1px solid var(--border-bright);
    border-radius: 8px;
    background: #101a28;
    color: var(--text);
    font: inherit;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
  }

  .graph-button:hover {
    border-color: var(--blue);
    background: #142237;
  }

  .graph-filter-button.active {
    border-color: var(--blue);
    background: rgba(56, 189, 248, 0.14);
    color: #bae6fd;
    box-shadow: 0 0 18px rgba(56, 189, 248, 0.12)
  }

  .graph-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 290px;
    min-height: 610px;
  }

  .graph-area {
    position: relative;
    min-width: 0;
    border-right: 1px solid var(--border);
    background:
      linear-gradient(rgba(45, 65, 90, 0.11) 1px, transparent 1px),
      linear-gradient(90deg, rgba(45, 65, 90, 0.11) 1px, transparent 1px),
      radial-gradient(circle at center, rgba(56, 189, 248, 0.06), transparent 55%),
      #060b12;
    background-size: 28px 28px, 28px 28px, auto, auto;
  }

  #network-graph {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 610px;
  }

  #packet-canvas {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .graph-inspector {
    padding: 20px;
    background: #0a111c;
  }

  .inspector-eyebrow {
    color: var(--blue);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .inspector-title {
    margin: 9px 0 5px;
    overflow-wrap: anywhere;
    font-size: 20px;
  }

  .inspector-subtitle {
    margin: 0 0 22px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
  }

  .inspector-list {
    display: grid;
    gap: 10px;
  }

  .inspector-row {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    font-size: 13px;
  }

  .inspector-row strong {
    max-width: 150px;
    color: var(--text);
    text-align: right;
    overflow-wrap: anywhere;
  }

  .inspector-status {
    display: inline-flex;
    margin-top: 18px;
    padding: 7px 10px;
    border: 1px solid var(--border-bright);
    border-radius: 8px;
    background: #101a28;
    color: var(--muted);
    font-size: 12px;
    font-weight: 800;
  }

  .dashboard-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .panel-content {
    padding: 18px;
  }

  .list {
    display: grid;
    gap: 8px;
  }

  .list-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    padding: 12px 13px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: #0a111b;
  }

  .list-main {
    min-width: 0;
  }

  .list-title {
    overflow: hidden;
    color: var(--text);
    font-size: 13px;
    font-weight: 750;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .list-subtitle {
    margin-top: 4px;
    color: var(--muted);
    font-size: 11px;
  }

  .list-value {
    color: #bae6fd;
    font-size: 13px;
    font-weight: 800;
  }

  .progress-track {
    height: 5px;
    margin-top: 8px;
    overflow: hidden;
    border-radius: 999px;
    background: #162233;
  }

  .progress-fill {
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #0ea5e9, #38bdf8);
  }

  .profile-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    padding: 18px;
  }

  .profile-item {
    padding: 14px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: #0a111b;
  }

  .profile-label {
    margin-bottom: 8px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .profile-value {
    color: var(--text);
    font-size: 13px;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .table-wrapper {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .data-table {
    width: 100%;
    min-width: 850px;
    border-collapse: collapse;
    background: #0a111b;
  }

  .data-table th {
    padding: 12px;
    border-bottom: 1px solid var(--border-bright);
    background: #101a28;
    color: #a9b8cc;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-align: left;
    text-transform: uppercase;
  }

  .data-table td {
    padding: 12px;
    border-bottom: 1px solid var(--border);
    color: #cad4e1;
    font-size: 12px;
  }

  .data-table tbody tr:hover {
    background: rgba(56, 189, 248, 0.045);
  }

  .service-badge,
  .risk-badge {
    display: inline-flex;
    padding: 5px 8px;
    border: 1px solid var(--border-bright);
    border-radius: 999px;
    background: #111b2a;
    font-size: 11px;
    font-weight: 750;
  }

  .alerts-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .alert-card {
    padding: 17px;
    border: 1px solid var(--border);
    border-left-width: 4px;
    border-radius: 12px;
    background: #0a111b;
  }

  .alert-card.low {
    border-left-color: var(--yellow);
  }

  .alert-card.medium {
    border-left-color: var(--orange);
  }

  .alert-card.high {
    border-left-color: var(--red);
  }

  .alert-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 13px;
  }

  .alert-title {
    margin: 0;
    font-size: 15px;
  }

  .alert-flow {
    margin: 0;
    color: #d9e4f1;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 12px;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .alert-reasons {
    margin: 12px 0 0;
    padding-left: 19px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.7;
  }

  .empty-state {
    padding: 28px;
    border: 1px dashed rgba(52, 211, 153, 0.45);
    border-radius: 12px;
    background: rgba(52, 211, 153, 0.05);
    color: #a7f3d0;
    text-align: center;
  }

  .footer-note {
    margin-top: 30px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
    color: #5f6e83;
    font-size: 12px;
    text-align: center;
  }

  @media (max-width: 1100px) {
    .stats-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .graph-layout {
      grid-template-columns: 1fr;
    }

    .graph-area {
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }

    .dashboard-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .nbm-page {
      padding: 16px;
    }

    .nbm-header {
      flex-direction: column;
    }

    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .profile-grid,
    .alerts-grid {
      grid-template-columns: 1fr;
    }

    .graph-toolbar {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>

<div class="nbm-page">
  <div class="nbm-container">
    <header class="nbm-header">
      <div>
        <h1 class="nbm-title">Network Behaviour Monitor</h1>

        <p class="nbm-subtitle">
          Baseline-driven network traffic analysis with local packet capture,
          flow aggregation, risk scoring and explainable anomaly detection.
        </p>
      </div>

      <div class="status-badge">
        <span class="status-dot"></span>
        Analysis ready
      </div>
    </header>

    <div class="card summary-strip">
      <span>
        <strong>Generated:</strong>
        <%= @analysis_result["generated_at"] %>
      </span>

      <span>
        <strong>Local device:</strong>
        <%= local_ip %>
      </span>

      <span>
        <strong>Refresh:</strong>
        <code>py .\src\main.py</code>
      </span>
    </div>

    <section class="stats-grid">
      <div class="card stat-card" style="--stat-glow: rgba(56, 189, 248, 0.18);">
        <div class="stat-label">Baseline flows</div>
        <div class="stat-value"><%= length(baseline_flows) %></div>
        <div class="stat-note">Normal behaviour samples</div>
      </div>

      <div class="card stat-card" style="--stat-glow: rgba(56, 189, 248, 0.18);">
        <div class="stat-label">Test flows</div>
        <div class="stat-value"><%= length(test_flows) %></div>
        <div class="stat-note">Observed connections</div>
      </div>

      <div class="card stat-card" style="--stat-glow: rgba(248, 113, 113, 0.18);">
        <div class="stat-label">Total alerts</div>
        <div class="stat-value"><%= length(alerts) %></div>
        <div class="stat-note">Flows requiring review</div>
      </div>

      <div class="card stat-card" style="--stat-glow: rgba(250, 204, 21, 0.16);">
        <div class="stat-label">Low / Medium</div>
        <div class="stat-value"><%= low_alerts %> / <%= medium_alerts %></div>
        <div class="stat-note">Lower-severity findings</div>
      </div>

      <div class="card stat-card" style="--stat-glow: rgba(239, 68, 68, 0.2);">
        <div class="stat-label">High risk</div>
        <div class="stat-value"><%= high_alerts %></div>
        <div class="stat-note">Priority investigations</div>
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <div>
          <h2 class="section-title">Live Network Map</h2>

          <p class="section-description">
            Select a host or connection to inspect its traffic details.
          </p>
        </div>
      </div>

      <div class ="card graph-card">
        <div class="graph-toolbar">
          <div class="legend">
            <span class="legend-item">
              <span class="legend-dot" style="background: #34d399;"></span>
              Local device
            </span>

            <span class="legend-item">
              <span class="legend-dot" style="background: #38bdf8;"></span>
              Normal host
            </span>

            <span class="legend-item">
              <span class="legend-dot" 
              style="background: #f87171; transform: rotate(45deg); border-radius: 2px"></span>
              Alert host
            </span>

            <span class="legend-item">
              <span class="legend-line" style="background: #41516a;"></span>
              Normal flow
            </span>

            <span class="legend-item">
              <span class="legend-line" style="background: #facc15;"></span>
              Low risk
            </span>

            <span class="legend-item">
              <span class="legend-line" style="background: #fb923c;"></span>
              Medium risk
            </span>

            <span class="legend-item">
              <span class="legend-line" style="background: #f87171;"></span>
              High risk
            </span>
          </div>


          <div class="graph-buttons">
            <button
              class="graph-button graph-filter-button active"
              data-filter="all"
              type="button"
            >
              All traffic
            </button>

            <button
              class="graph-button graph-filter-button"
              data-filter="alerts"
              type="button"
            >
              Alerts only
            </button>

            <button
              class="graph-button graph-filter-button"
              data-filter="normal"
              type="button"
            >
              Normal only
            </button>

            <button
              id="orbit-layout-button"
              class="graph-button"
              type="button"
            >
              Orbit
            </button>

            <button
              id="force-layout-button"
              class="graph-button"
              type="button"
            >
              Force
            </button>

            <button
              id="fit-graph-button"
              class="graph-button"
              type="button"
            >
              Fit
            </button>

            <button
              id="reset-graph-button"
              class="graph-button"
              type="button"
            >
              Reset
            </button>
          </div>
        </div>

        <div class="graph-layout">
          <div class="graph-area">
            <div id="network-graph"></div>
            <canvas id="packet-canvas" aria-hidden="true"></canvas>
          </div>

          <aside class="graph-inspector">
            <div class="inspector-eyebrow">Selection details</div>

            <h3 id="inspector-title" class="inspector-title">
              <%= local_ip %>
            </h3>

            <p id="inspector-subtitle" class="inspector-subtitle">
              Select a node or connection in the graph to inspect it.
            </p>

            <div class="inspector-list">
              <div class="inspector-row">
                <span>Type</span>
                <strong id="inspector-type">Local device</strong>
              </div>

              <div class="inspector-row">
                <span>Connections</span>
                <strong id="inspector-connections">
                  <%= length(test_flows) %>
                </strong>
              </div>

              <div class="inspector-row">
                <span>Protocol</span>
                <strong id="inspector-protocol">Multiple</strong>
              </div>

              <div class="inspector-row">
                <span>Service</span>
                <strong id="inspector-service">Multiple</strong>
              </div>

              <div class="inspector-row">
                <span>Packets</span>
                <strong id="inspector-packets">
                  <%= Enum.sum(Enum.map(test_flows, &(&1["packet_count"] || 0))) %>
                </strong>
              </div>

              <div class="inspector-row">
                <span>Transferred</span>
                <strong id="inspector-size">
                  <%= Enum.sum(Enum.map(test_flows, &(&1["total_size"] || 0))) %> bytes
                </strong>
              </div>
            </div>

            <span id="inspector-status" class="inspector-status">
              Monitoring source
            </span>
          </aside>
        </div>
      </div>
    </section>

    <section class="section dashboard-grid">
      <div class="card">
        <div class="panel-content">
          <div class="section-heading">
            <div>
              <h2 class="section-title">Top Talkers</h2>

              <p class="section-description">
                Destinations receiving the most data.
              </p>
            </div>
          </div>

          <div class="list">
            <%
              max_talker_size =
                top_talkers
                |> Enum.map(&(&1["total_size"] || 0))
                |> Enum.max(fn -> 1 end)
            %>

            <%= for talker <- Enum.take(top_talkers, 8) do %>
              <%
                total_size = talker["total_size"] || 0

                percentage =
                  if max_talker_size > 0 do
                    total_size / max_talker_size * 100
                  else
                    0
                  end
              %>

              <div class="list-row">
                <div class="list-main">
                  <div class="list-title"><%= talker["dst_ip"] %></div>

                  <div class="list-subtitle">Destination host</div>

                  <div class="progress-track">
                    <div
                      class="progress-fill"
                      style={"width: #{percentage}%;"}
                    >
                    </div>
                  </div>
                </div>

                <div class="list-value">
                  <%= total_size %> B
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="panel-content">
          <div class="section-heading">
            <div>
              <h2 class="section-title">Protocol Distribution</h2>

              <p class="section-description">
                Number of aggregated flows per protocol.
              </p>
            </div>
          </div>

          <div class="list">
            <%= for {protocol, count} <- protocol_distribution do %>
              <div class="list-row">
                <div class="list-main">
                  <div class="list-title"><%= protocol %></div>

                  <div class="list-subtitle">
                    Network protocol
                  </div>
                </div>

                <div class="list-value">
                  <%= count %> flows
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <div>
          <h2 class="section-title">Baseline Profile</h2>

          <p class="section-description">
            Behaviour learned from the normal traffic capture.
          </p>
        </div>
      </div>

      <div class="card profile-grid">
        <div class="profile-item">
          <div class="profile-label">Known source IPs</div>

          <div class="profile-value">
            <%= Enum.join(known_src_ips, ", ") %>
          </div>
        </div>

        <div class="profile-item">
          <div class="profile-label">Known protocols</div>

          <div class="profile-value">
            <%= Enum.join(known_protocols, ", ") %>
          </div>
        </div>

        <div class="profile-item">
          <div class="profile-label">Known destination ports</div>

          <div class="profile-value">
            <%= Enum.join(Enum.map(known_dst_ports, &to_string/1), ", ") %>
          </div>
        </div>

        <div class="profile-item">
          <div class="profile-label">Known services</div>

          <div class="profile-value">
            <%= Enum.join(known_services, ", ") %>
          </div>
        </div>

        <div class="profile-item" style="grid-column: 1 / -1;">
          <div class="profile-label">Known destination IPs</div>

          <div class="profile-value">
            <%= Enum.join(known_dst_ips, ", ") %>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <div>
          <h2 class="section-title">Alerts</h2>

          <p class="section-description">
            Explainable findings produced by the anomaly detection engine.
          </p>
        </div>
      </div>

      <%= if Enum.empty?(alerts) do %>
        <div class="empty-state">
          No unusual activity was detected in this analysis.
        </div>
      <% else %>
        <div class="alerts-grid">
          <%= for alert <- alerts do %>
            <% flow = alert["flow"] %>

            <div class={"alert-card #{String.downcase(alert["risk_level"] || "low")}"}>
              <div class="alert-header">
                <h3 class="alert-title">
                  <%= alert["type"] %>
                </h3>

                <span class="risk-badge">
                  <%= alert["risk_level"] %> · <%= alert["risk_score"] %>
                </span>
              </div>

              <p class="alert-flow">
                <%= flow["src_ip"] %>:<%= flow["src_port"] %>
                →
                <%= flow["dst_ip"] %>:<%= flow["dst_port"] %>
              </p>

              <p style="margin: 8px 0 0; color: var(--muted); font-size: 12px;">
                <%= flow["protocol"] %> · <%= flow["service"] %> ·
                <%= flow["packet_count"] %> packets ·
                <%= flow["total_size"] %> bytes
              </p>

              <ul class="alert-reasons">
                <%= for reason <- alert["reasons"] do %>
                  <li><%= reason %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
      <% end %>
    </section>

    <section class="section">
      <div class="section-heading">
        <div>
          <h2 class="section-title">Test Traffic Flows</h2>

          <p class="section-description">
            Aggregated outbound connections from the monitored device.
          </p>
        </div>
      </div>

      <div class="table-wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th>Source</th>
              <th>Destination</th>
              <th>Protocol</th>
              <th>Service</th>
              <th>Packets</th>
              <th>Total size</th>
            </tr>
          </thead>

          <tbody>
            <%= for flow <- test_flows do %>
              <tr>
                <td>
                  <%= flow["src_ip"] %>:<%= flow["src_port"] %>
                </td>

                <td>
                  <%= flow["dst_ip"] %>:<%= flow["dst_port"] %>
                </td>

                <td><%= flow["protocol"] %></td>

                <td>
                  <span class="service-badge">
                    <%= flow["service"] %>
                  </span>
                </td>

                <td><%= flow["packet_count"] %></td>
                <td><%= flow["total_size"] %> bytes</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <div>
          <h2 class="section-title">Baseline Traffic Flows</h2>

          <p class="section-description">
            Connections used to create the normal behaviour profile.
          </p>
        </div>
      </div>

      <div class="table-wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th>Source</th>
              <th>Destination</th>
              <th>Protocol</th>
              <th>Service</th>
              <th>Packets</th>
              <th>Total size</th>
            </tr>
          </thead>

          <tbody>
            <%= for flow <- baseline_flows do %>
              <tr>
                <td>
                  <%= flow["src_ip"] %>:<%= flow["src_port"] %>
                </td>

                <td>
                  <%= flow["dst_ip"] %>:<%= flow["dst_port"] %>
                </td>

                <td><%= flow["protocol"] %></td>

                <td>
                  <span class="service-badge">
                    <%= flow["service"] %>
                  </span>
                </td>

                <td><%= flow["packet_count"] %></td>
                <td><%= flow["total_size"] %> bytes</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <p class="footer-note">
      Local demonstration dashboard · Data loaded from analysis_result.json
    </p>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const graphContainer = document.getElementById("network-graph");

    if (!graphContainer || typeof cytoscape === "undefined") {
      return;
    }

    const flows =
      <%= Jason.encode!(test_flows) |> Phoenix.HTML.raw() %>;

    const alerts =
      <%= Jason.encode!(alerts) |> Phoenix.HTML.raw() %>;

    const localIp =
      <%= Jason.encode!(local_ip) |> Phoenix.HTML.raw() %>;

    const alertDestinations = new Set(
      alerts.map((alert) => alert.flow.dst_ip)
    );

    const destinationRisk = new Map();

    const riskPriority = {
      Normal: 0,
      Low: 1,
      Medium: 2,
      High: 3
    };

    for (const alert of alerts) {
      const destination = alert.flow.dst_ip;
      const currentRisk = destinationRisk.get(destination) || "Normal";

      if (
        riskPriority[alert.risk_level] >
        riskPriority[currentRisk]
      ) {
        destinationRisk.set(destination, alert.risk_level);
      }
    }

    const nodeIds = new Set();
    const elements = [];

    const ensureNode = (id) => {
      if (nodeIds.has(id)) {
        return;
      }

      const isLocal = id === localIp;
      const hasAlert = alertDestinations.has(id);

      elements.push({
        data: {
          id,
          label: isLocal ? "This Device" : id,
          fullLabel: id,
          nodeType: isLocal
            ? "local"
            : hasAlert
              ? "alert"
              : "normal",
          riskLevel: destinationRisk.get(id) || "Normal"
        }
      });

      nodeIds.add(id);
    };

    for (const flow of flows) {
      ensureNode(flow.src_ip);
      ensureNode(flow.dst_ip);

      const matchingAlert = alerts.find((alert) => {
        const alertFlow = alert.flow;

        return (
          alertFlow.src_ip === flow.src_ip &&
          alertFlow.dst_ip === flow.dst_ip &&
          alertFlow.src_port === flow.src_port &&
          alertFlow.dst_port === flow.dst_port &&
          alertFlow.protocol === flow.protocol
        );
      });

      elements.push({
        data: {
          id:
            `${flow.src_ip}-${flow.dst_ip}-` +
            `${flow.src_port}-${flow.dst_port}-` +
            `${flow.protocol}`,

          source: flow.src_ip,
          target: flow.dst_ip,

          protocol: flow.protocol,
          service: flow.service,
          packets: flow.packet_count,
          totalSize: flow.total_size,

          riskLevel: matchingAlert
            ? matchingAlert.risk_level
            : "Normal"
        }
      });
    }

    const graph = cytoscape({
      container: graphContainer,

      elements,

      minZoom: 0.25,
      maxZoom: 2.5,
      wheelSensitivity: 0.18,

      selectionType: "single",

      style: [
        {
          selector: "node",
          style: {
            "width": 28,
            "height": 28,
            "background-color": "#38bdf8",
            "border-width": 3,
            "border-color": "#075985",

            "label": "data(fullLabel)",
            "color": "#dbeafe",
            "font-size": 10,
            "font-weight": 650,

            "text-valign": "bottom",
            "text-halign": "center",
            "text-margin-y": 14,

            "text-background-color": "#060b12",
            "text-background-opacity": 0.82,
            "text-background-padding": 5,
            "text-background-shape": "roundrectangle",

          "text-border-width": 1,
          "text-border-color": "#38bdf8",

            "overlay-opacity": 0
          }
        },

        {
          selector: 'node[nodeType = "local"]',
          style: {
            "shape": "round-rectangle",
            "width": 70,
            "height": 70,

            "background-color": "#34d399",
            "border-width": 5,
            "border-color": "#a7f3d0",

            "label": "data(fullLabel)",
            "font-size": 13,
            "font-weight": 800,
            "color": "#d1fae5"
          }
        },

        {
          selector: 'node[nodeType = "alert"]',
          style: {
            "shape": "diamond",
            "width": 45,
            "height": 45,

            "background-color": "#f87171",
            "border-width": 4,
            "border-color": "#fecaca",

            "label": "data(label)",
            "color": "#fee2e2",
            "font-weight": 750
          }
        },

        {
          selector: "node:selected",
          style: {
            "border-width": 6,
            "border-color": "#ffffff",
            "overlay-opacity": 0
          }
        },

        {
          selector: "edge",
          style: {
            "width": "mapData(totalSize, 0, 1000000, 1.5, 5)",

            "line-color": "#64748b",


            "opacity": 0.72,

            "curve-style": "unbundled-bezier",
            "control-point-distances": [-25, 25],
            "control-point-weights": [0.35],

            "source-arrow-shape": "triangle",
            "source-arrow-color": "#64748b",

            "target-arrow-shape": "triangle",
            "target-arrow-color": "#64748b",

            "source-distance-from-node": 3,
            "target-distance-from-node": 3,

            "arrow-scale": 0.85,

            "overlay-opacity": 0
          }
        },

        {
          selector: 'edge[riskLevel = "Low"]',
          style: {
            "line-color": "#facc15",
            "source-arrow-color": "#facc15",
            "target-arrow-color": "#facc15",
            "opacity": 0.95,
            "shadow-color": "#facc15",
            "shadow-opacity": 0.7,
            "shadow-blur": 12,
          }
        },

        {
          selector: 'edge[riskLevel = "Medium"]',
          style: {
            "line-color": "#f59e0b",
            "source-arrow-color": "#f59e0b",
            "target-arrow-color": "#f59e0b",
            "opacity": 1,
            "shadow-color": "#f59e0b",
            "shadow-opacity": 0.9,
            "shadow-blur": 18,
          }
        },

        {
          selector: 'edge[riskLevel = "High"]',
          style: {
            "line-color": "#ef4444",
            "source-arrow-color": "#ef4444",
            "target-arrow-color": "#ef4444",
            "opacity": 1,
            "shadow-color": "#ef4444",
            "shadow-opacity": 0.9,
            "shadow-blur": 18,
          }
        },

        {
          selector: "edge:selected",
          style: {
            "width": 5,
            "line-color": "#ffffff",
            "source-arrow-color": "#ffffff",
            "target-arrow-color": "#ffffff",
            "opacity": 1,
            "overlay-opacity": 0
          }
        },

        {
          selector: ".faded",
          style: {
            "opacity": 0.12
          }
        },

        {
          selector: ".highlighted",
          style: {
            "opacity": 1
          }
        }
      ],

      layout: {
        name: "concentric",
        animate: false,
        padding: 70,
        minNodeSpacing: 92,
        avoidOverlap: true,
        startAngle: -Math.PI / 2,
        clockwise: true,

        concentric: (node) => {
          if (node.id() === localIp) {
            return 100;
          }

          if (node.data("nodeType") === "alert") {
            return 50;
          }

          return 10;
        },

        levelWidth: () => 1
      }
    });

    const packetCanvas = document.getElementById("packet-canvas");
    const packetContext = packetCanvas?.getContext("2d");
    const graphArea = graphContainer.closest(".graph-area");

    const packetColours = {
      Normal: "#e2e8f0",
      Low: "#facc15",
      Medium: "#fb923c",
      High: "#ef4444"
    };

    const packetState = new Map();
    let packetAnimationFrame = null;
    let lastPacketFrame = performance.now();

    const resizePacketCanvas = () => {
      if (!packetCanvas || !graphArea || !packetContext) {
        return;
      }

      const ratio = window.devicePixelRatio || 1;
      const width = graphArea.clientWidth;
      const height = graphArea.clientHeight;

      packetCanvas.width = Math.max(1, Math.floor(width * ratio));
      packetCanvas.height = Math.max(1, Math.floor(height * ratio));
      packetCanvas.style.width = `${width}px`;
      packetCanvas.style.height = `${height}px`;
      packetContext.setTransform(ratio, 0, 0, ratio, 0, 0);
    };

    const quadraticPoint = (start, control, end, t) => {
      const inverse = 1 - t;

      return {
        x:
          inverse * inverse * start.x +
          2 * inverse * t * control.x +
          t * t * end.x,
        y:
          inverse * inverse * start.y +
          2 * inverse * t * control.y +
          t * t * end.y
      };
    };

    const midpoint = (first, second) => ({
      x: (first.x + second.x) / 2,
      y: (first.y + second.y) / 2
    });

    const getEdgeSegments = (edge) => {
      const start = edge.renderedSourceEndpoint();
      const end = edge.renderedTargetEndpoint();
      const controls = edge.renderedControlPoints();

      if (!controls || controls.length === 0) {
        return [{ start, control: midpoint(start, end), end }];
      }

      if (controls.length === 1) {
        return [{ start, control: controls[0], end }];
      }

      return controls.map((control, index) => {
        const segmentStart =
          index === 0
            ? start
            : midpoint(controls[index - 1], control);

        const segmentEnd =
          index === controls.length - 1
            ? end
            : midpoint(control, controls[index + 1]);

        return {
          start: segmentStart,
          control,
          end: segmentEnd
        };
      });
    };

    const pointOnEdge = (edge, progress) => {
      const segments = getEdgeSegments(edge);
      const safeProgress = Math.max(0, Math.min(0.999999, progress));
      const scaledProgress = safeProgress * segments.length;
      const segmentIndex = Math.min(
        segments.length - 1,
        Math.floor(scaledProgress)
      );
      const localProgress = scaledProgress - segmentIndex;
      const segment = segments[segmentIndex];

      return quadraticPoint(
        segment.start,
        segment.control,
        segment.end,
        localProgress
      );
    };

    const drawPacket = (point, colour, radius) => {
      packetContext.beginPath();
      packetContext.arc(point.x, point.y, radius, 0, Math.PI * 2);
      packetContext.fillStyle = colour;
      packetContext.shadowColor = colour;
      packetContext.shadowBlur = 9;
      packetContext.fill();
      packetContext.shadowBlur = 0;
    };

    const animatePackets = (now) => {
      if (!packetContext || !packetCanvas) {
        return;
      }

      const delta = Math.min(40, now - lastPacketFrame);
      lastPacketFrame = now;

      packetContext.clearRect(
        0,
        0,
        packetCanvas.clientWidth,
        packetCanvas.clientHeight
      );

      graph.edges(":visible").forEach((edge) => {
        const id = edge.id();
        const existing = packetState.get(id) || {
          forward: Math.random(),
          reverse: Math.random()
        };

        const packetCount = Number(edge.data("packets") || 1);
        const speed = 0.00008 * Math.min(4, 1 + Math.log10(packetCount + 1));

        existing.forward = (existing.forward + delta * speed) % 1;
        existing.reverse = (existing.reverse + delta * speed * 0.82) % 1;
        packetState.set(id, existing);

        const riskLevel = edge.data("riskLevel") || "Normal";
        const colour = packetColours[riskLevel] || packetColours.Normal;
        const radius = riskLevel === "High" ? 3.2 : riskLevel === "Medium" ? 2.8 : 2.4;

        drawPacket(
          pointOnEdge(edge, existing.forward),
          colour,
          radius
        );

        drawPacket(
          pointOnEdge(edge, 1 - existing.reverse),
          colour,
          Math.max(2, radius - 0.35)
        );
      });

      packetAnimationFrame = requestAnimationFrame(animatePackets);
    };

    resizePacketCanvas();
    window.addEventListener("resize", resizePacketCanvas);
    graph.on("render pan zoom position layoutstop", resizePacketCanvas);
    packetAnimationFrame = requestAnimationFrame(animatePackets);

    window.addEventListener("beforeunload", () => {
      if (packetAnimationFrame) {
        cancelAnimationFrame(packetAnimationFrame);
      }
    });

    const inspectorTitle =
      document.getElementById("inspector-title");

    const inspectorSubtitle =
      document.getElementById("inspector-subtitle");

    const inspectorType =
      document.getElementById("inspector-type");

    const inspectorConnections =
      document.getElementById("inspector-connections");

    const inspectorProtocol =
      document.getElementById("inspector-protocol");

    const inspectorService =
      document.getElementById("inspector-service");

    const inspectorPackets =
      document.getElementById("inspector-packets");

    const inspectorSize =
      document.getElementById("inspector-size");

    const inspectorStatus =
      document.getElementById("inspector-status");

    const updateNodeInspector = (node) => {
      const connectedEdges = node.connectedEdges();

      const protocols = [
        ...new Set(
          connectedEdges.map((edge) => edge.data("protocol"))
        )
      ].filter(Boolean);

      const services = [
        ...new Set(
          connectedEdges.map((edge) => edge.data("service"))
        )
      ].filter(Boolean);

      const packetCount = connectedEdges.reduce(
        (total, edge) => total + Number(edge.data("packets") || 0),
        0
      );

      const totalSize = connectedEdges.reduce(
        (total, edge) => total + Number(edge.data("totalSize") || 0),
        0
      );

      const nodeType = node.data("nodeType");
      const riskLevel = node.data("riskLevel") || "Normal";

      inspectorTitle.textContent = node.data("fullLabel");
      inspectorSubtitle.textContent =
        nodeType === "local"
          ? "Monitored local network device."
          : "Remote destination observed in captured traffic.";

      inspectorType.textContent =
        nodeType === "local"
          ? "Local device"
          : nodeType === "alert"
            ? "Alert destination"
            : "Normal destination";

      inspectorConnections.textContent = connectedEdges.length;

      inspectorProtocol.textContent =
        protocols.length > 0
          ? protocols.join(", ")
          : "Not available";

      inspectorService.textContent =
        services.length > 0
          ? services.join(", ")
          : "Not available";

      inspectorPackets.textContent = packetCount;
      inspectorSize.textContent = `${totalSize} bytes`;

      inspectorStatus.textContent =
        nodeType === "local"
          ? "Monitoring source"
          : riskLevel === "Normal"
            ? "Normal destination"
            : `${riskLevel} risk destination`;
    };

    const updateEdgeInspector = (edge) => {
      inspectorTitle.textContent =
        `${edge.source().id()} → ${edge.target().id()}`;

      inspectorSubtitle.textContent =
        "Aggregated network flow between two hosts.";

      inspectorType.textContent = "Network connection";
      inspectorConnections.textContent = "1";
      inspectorProtocol.textContent = edge.data("protocol");
      inspectorService.textContent = edge.data("service");
      inspectorPackets.textContent = edge.data("packets");
      inspectorSize.textContent = `${edge.data("totalSize")} bytes`;

      inspectorStatus.textContent =
        edge.data("riskLevel") === "Normal"
          ? "Normal connection"
          : `${edge.data("riskLevel")} risk connection`;
    };

    const highlightElement = (element) => {
      graph.elements().addClass("faded");

      element.removeClass("faded").addClass("highlighted");

      if (element.isNode()) {
        element
          .closedNeighborhood()
          .removeClass("faded")
          .addClass("highlighted");
      } else {
        element
          .connectedNodes()
          .removeClass("faded")
          .addClass("highlighted");
      }
    };

    graph.on("tap", "node", (event) => {
      const node = event.target;

      highlightElement(node);
      updateNodeInspector(node);
    });

    graph.on("tap", "edge", (event) => {
      const edge = event.target;

      highlightElement(edge);
      updateEdgeInspector(edge);
    });

    graph.on("tap", (event) => {
      if (event.target === graph) {
        graph.elements().removeClass("faded highlighted");
        graph.elements().unselect();
      }
    });

    graph.on("mouseover", "node, edge", () => {
      graphContainer.style.cursor = "pointer";
    });

    graph.on("mouseout", "node, edge", () => {
      graphContainer.style.cursor = "default";
    });

    graph.on("mouseover", "node", (event) => {
      const node = event.target;

      const originalWidth = node.width();
      const originalHeight = node.height();

      node.scratch("originalWidth", originalWidth);
      node.scratch("originalHeight", originalHeight);

      node.style({
        "label": "data(fullLabel)",
        "width": originalWidth + 8,
        "height": originalHeight + 8,
        "border-color": "#ffffff",
        "border-width": 4
      });

      graph.elements().addClass("faded");
      node.closedNeighborhood().removeClass("faded").addClass("highlighted");
    });

    graph.on("mouseout", "node", (event) => {
      const node = event.target;

      node.style({
        "width": node.scratch("originalWidth"),
        "height": node.scratch("originalHeight"),
        "border-color":
          node.data("nodeType") === "local"
            ? "#a7f3d0"
            : node.data("nodeType") === "alert"
              ? "#fecaca"
              : "#075985",
        "border-width":
          node.data("nodeType") === "local"
            ? 5
            : node.data("nodeType") === "alert"
              ? 4
              : 3
      });

      if (graph.$(":selected").empty()) {
        graph.elements().removeClass("faded highlighted");
      }
    });

    const runOrbitLayout = () => {
      graph.layout({
        name: "concentric",
        animate: true,
        animationDuration: 650,
        animationEasing: "ease-in-out",
        padding: 70,
        minNodeSpacing: 92,
        avoidOverlap: true,
        startAngle: -Math.PI / 2,
        clockwise: true,
        concentric: (node) => {
          if (node.id() === localIp) return 100;
          if (node.data("nodeType") === "alert") return 50;
          return 10;
        },
        levelWidth: () => 1
      }).run();
    };

    const runForceLayout = () => {
      graph.layout({
        name: "cose",
        animate: true,
        animationDuration: 850,
        animationEasing: "ease-in-out",
        fit: true,
        padding: 70,
        randomize: true,
        nodeRepulsion: 11000,
        idealEdgeLength: 125,
        edgeElasticity: 80,
        gravity: 0.6,
        numIter: 900
      }).run();
    };

    document.querySelectorAll(".graph-filter-button").forEach((button) => {
      button.addEventListener("click", () => {
        document
          .querySelectorAll(".graph-filter-button")
          .forEach((item) => item.classList.remove("active"));

        button.classList.add("active");
        const filter = button.dataset.filter;

        graph.batch(() => {
          graph.elements().show();

          if (filter === "alerts") {
            graph.edges('[riskLevel = "Normal"]').hide();
            graph.nodes().forEach((node) => {
              if (
                node.id() !== localIp &&
                node.connectedEdges(":visible").empty()
              ) {
                node.hide();
              }
            });
          }

          if (filter === "normal") {
            graph.edges().not('[riskLevel = "Normal"]').hide();
            graph.nodes().forEach((node) => {
              if (
                node.id() !== localIp &&
                node.connectedEdges(":visible").empty()
              ) {
                node.hide();
              }
            });
          }
        });

        graph.fit(graph.elements(":visible"), 70);
      });
    });

    document
      .getElementById("orbit-layout-button")
      ?.addEventListener("click", runOrbitLayout);

    document
      .getElementById("force-layout-button")
      ?.addEventListener("click", runForceLayout);

    document
      .getElementById("fit-graph-button")
      ?.addEventListener("click", () => {
        graph.fit(graph.elements(), 55);
      });

    document
      .getElementById("reset-graph-button")
      ?.addEventListener("click", () => {
        graph.elements().show();
        graph.elements().removeClass("faded highlighted");
        graph.elements().unselect();

        document
          .querySelectorAll(".graph-filter-button")
          .forEach((item) => item.classList.remove("active"));

        document
          .querySelector('.graph-filter-button[data-filter="all"]')
          ?.classList.add("active");

        runOrbitLayout();
      });

    graph.ready(() => {
      resizePacketCanvas();
      graph.fit(graph.elements(), 70);
    });

    graph.on("layoutstop", () => {
      graph.fit(graph.elements(":visible"), 70);
    });
  });
</script>